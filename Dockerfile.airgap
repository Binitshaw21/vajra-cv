# Base image for a production-ready secure ML runtime
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY . /app/

RUN useradd --create-home --uid 10001 vajra && chown -R vajra:vajra /app
USER vajra

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "engine.api_gateway:app", "--host", "0.0.0.0", "--port", "8000"]
